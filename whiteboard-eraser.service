[Unit]
Description=Whiteboard Eraser Car Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/whiteboard-eraser
Environment=PYTHONPATH=/home/pi/whiteboard-eraser
ExecStart=/usr/bin/python3 /home/pi/whiteboard-eraser/whiteboard_eraser_main.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Give the service time to start up
TimeoutStartSec=60

# Environment variables for GPIO access
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target